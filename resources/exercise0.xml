<mujoco model="demo">
  <compiler angle="degree" coordinate="local"/>

  <!-- Gravity is enabled by default -->
  <option gravity="0 0 0" timestep="0.002">
    <flag warmstart="enable"/>
  </option>

  <!-- Visual settings -->
  <visual>
    <headlight ambient="0.5 0.5 0.5" diffuse="0.8 0.8 0.8"/>
    <rgba haze="0.15 0.25 0.35 1"/>  <!-- Haze for depth perception -->
    <global azimuth="10" elevation="-40"/>
  </visual>

  <!-- Assets: materials and textures -->
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.3 0.4 0.5" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance="0.2"/>
    <material name="robot" rgba="0.7 0.3 0.3 1"/>
    <material name="object" rgba="0.3 0.7 0.3 1"/>
  </asset>

  <!-- World body -->
  <worldbody>
    <!-- Floor -->
    <geom name="floor" type="plane" size="5 5 0.1" material="grid"/>

    <!-- Lighting -->
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>

    <!-- Static objects -->
    <!--
    <body name="static_box" pos="0 0 2">
      <geom name="box" type="box" size="0.25 0.25 0.25" rgba="0.8 0.4 0.1 1" mass="0.2"/>
    </body>
    -->

    <!-- Free-falling objects -->
    <!-- TODO -->
    <!--
    <body name="falling_sphere" pos="0 0 8">
      <geom name="sphere1" type="sphere" size="0.25 0.25 0.25" rgba="0.8 0.4 0.1 1" mass="0.2"/>
      <freejoint/>
    </body>
    -->

    <!-- Simple 2-link robot arm -->
    <!-- TODO -->
    <!-- Notes:
    - Pos is the center of the object
    - size of the geom is the half-size of the object (so 0.25 0.25 0.25 means its a 0.5x0.5x0.5 box)

    - to make rotation happen, the body and the joint should be at the point of rotation
    - the geom should be at 0 0 0 (bodys origin)

    -fromto is relative to the bodys origin
    -->

    <body name="robot_base" pos="0 0 0.25">
      <geom name="robot_base_geom" type="box" size="0.25 0.25 0.25" rgba="0.8 0.4 0.1 1" mass="0.2"/>
      <!--body centered at z = 0.25 with size 0.5x0.5x0.5-->

      <body name="link1" pos="0 0 0">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-180 180" damping="0.1"/>
        <geom name="link1_geom" type="capsule" size="0.125" fromto="0 0 0 0 0 1" material="robot"/>
        <!--
          this body is centered with respect to robot_base, so world coord center is same as z=0.25
          fromto decides the size, wrt this bodys origin so it goes from 0.25 to 1.25 world coord
         -->

        <body name="link2" pos="0 0 1">
          <joint name="joint2" type="hinge" axis="0 1 0" range="-180 180" damping="0.1"/>
          <geom name="link2_geom" type="capsule" size="0.125" fromto="0 0 0 0.5 0 0" material="robot"/>
          <!--
            centered at 0 0 1 so that the point of origin is z=1.25 world coord 
            fromto starts at 0 0 0 and 1 0 0 because it is respective to bodys oriign 
          -->
        </body>
      </body>
    </body>

  </worldbody>

</mujoco>

